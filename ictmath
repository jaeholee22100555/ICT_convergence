# evaluate 함수
def evaluate(node):
    stack = [node]  # 초기 스택에 루트 노드를 추가
    while stack:
        top = stack[-1]  # 스택의 맨 위에 있는 노드를 가져옴
        if top.data is not None:  # top 노드가 데이터를 가지고 있다면
            stack.pop()  # 스택에서 제거
        else:
            lnode = top.left
            rnode = top.right
            # 자식 노드들(lnode, rnode)이 None이 아니고, 값이 설정되었는지 확인
            if lnode.data is not None and rnode.data is not None:
