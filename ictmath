                    top.data = lnode.data.symmetric_difference(rnode.data)
                elif top.data == '|':
                    top.data = lnode.data.union(rnode.data)
                elif top.data == '&':
                    top.data = lnode.data.intersection(rnode.data)
                elif top.data == '-':
                    top.data = lnode.data.difference(rnode.data)
                stack.pop()  # top 노드를 처리한 후 제거
            else:
                # 아직 처리할 수 없다면, 자식 노드를 스택에 추가
